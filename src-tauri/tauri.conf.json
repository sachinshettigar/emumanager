{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emulator Studio",
  "version": "0.1.0",
  "identifier": "com.emulatorstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emulator Studio",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Create, launch and share Android emulators without Android Studio.",
    "longDescription": "Emulator Studio is a cross-platform desktop app to create, launch, track and share Android emulators. It manages the Android command-line SDK for you — no Android Studio, no terminal.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBMDI5QUEyN0I3MkI1RUUKUldUdXRYSjdvcG9DaXIxUnpkc3RZaHdwaUIva05TbkF0dVg0MGZnb1h2TCtnNGxXSmhXdklRbjcK",
      "endpoints": [
        "https://github.com/sachinshettigar/emumanager/releases/latest/download/latest.json"
      ]
    }
  }
}
